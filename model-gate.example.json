{
  "$schema": "./model-gate.schema.json",
  "version": 1,
  "listen": "127.0.0.1:9000",
  "auto_model": "example-model",
  "tailscale_readonly_users": [],
  "memory_profile_gb": 128,
  "require_unload": true,
  "upstream_timeout": 600,
  "queue_timeout": 600,
  "backends": {
    "ds4": {
      "type": "ds4",
      "binary": "ds4-server",
      "port": "auto",
      "models": {
        "example-model": {
          "path": "/absolute/path/to/model.gguf",
          "context": 200000,
          "args": []
        }
      },
      "kv_disk_space_mb": 65536,
      "startup_timeout": 120,
      "unload_timeout": 120
    },
    "omlx": {
      "type": "omlx",
      "base_url": "http://127.0.0.1:8001",
      "discover_models": true,
      "model_list_path": "/v1/models",
      "model_status_path": "/v1/models/status",
      "load_url": "/admin/api/models/{model}/load",
      "unload_url": "/admin/api/models/{model}/unload",
      "max_concurrency": 1
    }
  }
}

{
  "listen": "0.0.0.0:9000",
  "require_unload": true,
  "lifecycle_timeout": 30,
  "upstream_timeout": 600,
  "lifecycle_failure_cooldown": 5,
  "max_body_bytes": 67108864,
  "model_discovery_timeout": 3,
  "backends": {
    "port-8000": {
      "base_url": "http://127.0.0.1:8000",
      "max_concurrency": 1,
      "discover_models": true,
      "requires_unload": false
    },
    "omlx": {
      "base_url": "http://127.0.0.1:8001",
      "max_concurrency": 1,
      "discover_models": true,
      "model_policies": {
        "mlx-community--Qwen3-Coder-Next-nvfp4": {"max_concurrency": 8, "sharing_group": "light"},
        "ThinkingCap-Qwen3.6-27B-oQ6e-mtp": {"max_concurrency": 2, "sharing_group": "light"},
        "Qwen3.5-122B-A10B-oQ4e-mtp": {"max_concurrency": 1}
      },
      "settle_seconds": 2,
      "unload_settle_seconds": 5,
      "load_settle_seconds": 2,
      "models": [
        "qwen3-coder-next",
        "Qwen3.5-122B-A10B-oQ4e-mtp",
        "ThinkingCap-Qwen3.6-27B-oQ6e-mtp",
        "mlx-community--Qwen3-Coder-Next-nvfp4"
      ],
      "prefixes": ["qwen3", "mlx-community--", "unsloth--"],
      "unload_url": "http://127.0.0.1:8001/admin/api/models/{model}/unload",
      "load_url": "http://127.0.0.1:8001/admin/api/models/{model}/load"
    },
    "mtplx": {
      "base_url": "http://127.0.0.1:8002",
      "max_concurrency": 1,
      "discover_models": true,
      "requires_unload": false
    },
    "ds4": {
      "base_url": "http://127.0.0.1:8003",
      "max_concurrency": 1,
      "discover_models": false,
      "requires_unload": false,
      "settle_seconds": 5,
      "ready_path": "/v1/models",
      "startup_timeout": 120,
      "startup_poll_seconds": 1,
      "stop_on_proxy_exit": true,
      "models": [
        "ds4-0731",
        "ds4-vision",
        "glm5.3-flash"
      ],
      "model_commands": {
        "ds4-0731": ["/path/to/ds4-server", "--chdir", "/path/to", "-m", "/path/to/ds4-0731.gguf", "--host", "0.0.0.0", "--port", "8003", "--ctx", "200000"],
        "ds4-vision": ["/path/to/ds4-server", "--chdir", "/path/to", "-m", "/path/to/ds4-vision.gguf", "--vision", "/path/to/ds4-vision-encoder.gguf", "--host", "0.0.0.0", "--port", "8003", "--ctx", "200000"],
        "glm5.3-flash": ["/path/to/ds4-server", "--chdir", "/path/to", "-m", "/path/to/glm5.3-flash.gguf", "--vision", "/path/to/glm5.3-flash-vision-encoder.gguf", "--mtp", "--host", "0.0.0.0", "--port", "8003", "--ctx", "200000"]
      }
    }
  }
}
